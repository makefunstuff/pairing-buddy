// pairing-buddy config. JSON with // comments. The daemon takes a change as you save it; `pair doctor` checks it.
{
  // How often Pair speaks unasked: "quiet", "normal" or "chatty".
  "level": "normal",

  // Your verdicts on Pair's unasked remarks (useful or not; ignored counts as not) tune each trigger's bar
  // and the level's budget, within fixed bounds. `pair stats` shows how. false keeps the level's defaults.
  "autoTune": true,

  // While you work, Pair asks the Watcher's model for one token every 4 min, so a server that unloads idle
  // models (many do after 5 min) still has it loaded when a remark needs scoring. false turns it off; with an
  // "anthropic" or a "provider" Watcher it is off unless set.
  "keepWarm": true,

  // While the Watcher's calls take 1.5 s or more, Pair asks it about fewer kinds of moment: the ones you can see on
  // your screen go first, the ones you cannot (a failure you missed, a crash) never. false asks about every kind.
  "watcherPace": true,

  // Tests Pair runs in its own herdr pane when you save a source file in a project: the project's folder and the
  // command, or {"command": ..., "timeoutSeconds": 600, "affected": false} for a longer cap, or the whole command on
  // every save. Most runners also put each test's result on its line (go test -json, jest --json, cargo test, pytest -v).
  // "testOnSave": {"~/src/shop": "go test -json ./..."},

  // The work board's command, Shepherdr's: a session takes its goal from the board task of its branch (matched by the
  // repo's space and the number), the context card (:Pair context) shows the task, the chat's header counts the space's
  // tasks, and /gen board composes a task to add. null turns it off; without the command, nothing is read.
  // "board": "shepherdr",

  // A project is a git root (each git worktree is one). In a monorepo, these folders are projects of their own;
  // "<folder>/*" makes each folder in it one.
  // "sessionRoots": ["~/src/shop/packages/*"],

  // Your other agents: when one needs you, is ready to merge or is done, Pair says so in one line at your next
  // breakpoint (a save, a run that ended, a stop to look). It reads herdr's agents and the board above, if there is
  // one. false turns the relay off.
  // "agents": false,

  // What :Pair tasks runs for each task you say yes to, in the project, as a list of words: {title} and {description}
  // are put in as whole words, never through a shell. Without it, the tasks are copied as a Markdown checklist.
  // "taskCommand": ["gh", "issue", "create", "--title", "{title}", "--body", "{description}"],

  // What one /gen request may do at most (see docs/gen.md); they stop a model that loops. The note its brief has
  // when you pinned none (/brief), when the project has it; null for the goal and the board task only. The days a
  // /gen try folder or a scaffold's copy stays, whether their runs reach the network, and where a /gen scaffold goes:
  // "tree", a copy in Pair's data folder, or "worktree", a git worktree on a branch gen/<n>. The defaults:
  // "gen": {"limits": {"files": 40, "lines": 4000, "commands": 8, "minutes": 10}, "brief": "NOTES.md", "keepTries": 7, "network": false, "scaffold": "tree"},

  // Pair's own pane, where Scout's commands and the tests on save run (see docs/scout.md#pairs-pane): your rc file
  // for its aliases, functions and PATH (true is ~/.bashrc), and the bubblewrap sandbox: "auto" where bwrap works,
  // true always, false never; inside it only the project and `writable` keep what is written, and no network unless allowed.
  // "scoutPane": {"rc": "~/.bashrc", "sandbox": "auto", "network": false, "writable": ["~/.cache"]},

  // One model for both roles: the Watcher asks it for one number without thinking, so it stays fast; the Partner
  // asks it with thinking. Its server needs to hold only this model, and may answer one request at a time: the
  // Watcher then waits while the Partner works, and your questions go first.
  "model": {
    "api": "openai",                        // "openai" (any OpenAI-compatible server) or "anthropic"; or a "provider"
    "baseUrl": "http://localhost:8080/v1",
    "model": "your-model"
    // "contextWindow": 32768,              // Pair asks the server what it serves; set it where the server does not say (32768 then)
    // How much the Partner thinks, by kind of turn (these are the defaults), or one level for all; "off" switches
    // it off. Levels: off, minimal, low, medium, high, xhigh. A remark comes a few seconds later; that is fine.
    // "thinking": {"navigator": "medium", "scout": "medium", "driver": "medium", "remark": "low", "gen": "medium"},
    // "reasoning": false,                  // for a model that cannot think: Pair then sends it no thinking level
    // How the server takes thinking: its chat template's switch, and the level as reasoning_effort or a budget
    // (without that, every level is just "on"). `pair doctor --thinking` finds it and prints the line:
    // "compat": {"thinkingFormat": "...", "supportsReasoningEffort": true},
    // "samplingParams": {"temperature": 0.3}, // steadier Partner answers when the server's default is high
    // "auth": "my-server"                  // a key stored by `pair auth login my-server`; or "apiKeyEnv", "apiKey", "apiKeyFile"
    // A cloud model instead: a provider pi-ai knows, with a subscription login or an API key from
    // `pair auth login PROVIDER` (`pair auth list` lists the providers, `pair auth models PROVIDER` their models).
    // A subscription's requests count against its plan's limits, and its terms decide whether a tool like this
    // may use it (see "Logins and keys" in docs/models.md).
    // "provider": "anthropic", "model": "your-cloud-model"
  }

  // Or a model for each role, in place of "model": a small fast Watcher (under 1 s per answer) and a larger
  // Partner. The Watcher never thinks ("reasoning": true on a model that thinks by default lets Pair switch it off).
  // "watcher" may also be "same as partner".
  // "models": {
  //   "watcher": {"api": "openai", "baseUrl": "http://localhost:8080/v1", "model": "your-small-model"},
  //   "partner": {"api": "openai", "baseUrl": "http://localhost:8081/v1", "model": "your-larger-model"}
  // }

  // Optional: a decision (classifier) model the speak gate asks, with probabilities, whether a moment is worth a
  // remark now, so fewer moments go to the Watcher. Without it the Watcher's score and the bar decide; down or slower
  // than "timeoutMs", Pair goes by them at once (see docs/decision.md). `pair auth models openrouter` lists them.
  // "decision": {"provider": "openrouter", "model": "typesafe/jev-1.14", "timeoutMs": 1500},
  // Or a gateway: {"api": "openai" (OpenAI's Decisions API) or "system-one", "baseUrl": "...", "model": "..."}

  // Push-to-talk: hold Alt-t in Neovim and ask aloud. whisper.cpp writes it down on the CPU (see docs/voice.md).
  // "voice": {
  //   "model": "~/src/whisper.cpp/models/ggml-base.en.bin",
  //   "whisper": "whisper-cli",            // the program, on PATH or a path
  //   "speak": "espeak-ng"                 // reads an answer aloud, only when you are away from the editor
  // },
  // Or through OpenRouter, without whisper.cpp: a transcription model hears, a speech model reads aloud.
  // "voice": {
  //   "openrouter": {
  //     "apiKeyFile": "~/.config/openrouter.key",
  //     "hear": "openai/whisper-large-v3-turbo",
  //     "speak": {"model": "x-ai/grok-voice-tts-1.0", "voice": "eve"}
  //   }
  // },

  // Also: "typingPauseMs" (default 2000), "socket" and "dataDir" (see docs/config.md).
}
