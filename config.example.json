// pairing-buddy config. JSON with // comments. After a change: systemctl --user restart pairing-buddy
// (or `pair setup` again), then `pair doctor` to check it.
{
  // How often Pair speaks unasked: "quiet", "normal" or "chatty".
  "level": "normal",

  // Your verdicts on Pair's unasked remarks (useful or not; ignored counts as not) tune each trigger's bar
  // and the level's budget, within fixed bounds. `pair stats` shows how. false keeps the level's defaults.
  "autoTune": true,

  // While you work, Pair asks the Watcher's model for one token every 4 min, so a server that unloads idle
  // models (many do after 5 min) still has it loaded when a remark needs scoring. false turns it off; with an
  // "anthropic" Watcher it is off unless set.
  "keepWarm": true,

  // Tests Pair runs in its own herdr pane when you save a source file in a project: the project's folder and the
  // command. JSON reports (go test -json, jest --json, vitest --reporter=json) also put each test's result on its line.
  // "testOnSave": {"~/src/shop": "go test -json ./..."},

  "models": {
    // The Watcher scores every candidate remark with one number, so it must be fast: under 1 s per answer.
    // It never thinks; thinking belongs to the Partner.
    // On a server that keeps one model in memory, give both roles the same model (or the Watcher uses the
    // Partner's model whenever only that one is loaded, rather than make the server reload).
    "watcher": {
      "api": "openai",                      // "openai" (any OpenAI-compatible server) or "anthropic"
      "baseUrl": "http://localhost:8080/v1",
      "model": "your-small-model",
      "contextWindow": 32768
      // "reasoning": true,                 // for a model that thinks by default, so Pair can switch it off
      // "compat": {"thinkingFormat": "qwen-chat-template"},  // the thinking switch of its chat template, if it has one
      // "apiKeyEnv": "MY_SERVER_KEY"       // or "apiKey", or "apiKeyFile": "~/.config/my-server.key"
    },

    // The Partner writes the words and calls the tools, and thinks before it does. One model can serve both roles.
    "partner": {
      "api": "openai",
      "baseUrl": "http://localhost:8080/v1",
      "model": "your-larger-model",
      "contextWindow": 65536
      // How much it thinks, by kind of turn (these are the defaults), or one level for all; "off" switches it off.
      // Levels: off, minimal, low, medium, high, xhigh. A remark comes a few seconds later; that is fine.
      // "thinking": {"navigator": "medium", "scout": "medium", "driver": "medium", "remark": "low"},
      // "reasoning": false,                // for a model that cannot think: Pair then sends it no thinking level
      // "compat": {"thinkingFormat": "qwen-chat-template"},  // the thinking switch of its chat template, if it has one
      // "samplingParams": {"temperature": 0.3}   // steadier answers when the server's default is high
      // A cloud Partner instead:
      // "api": "anthropic", "model": "your-cloud-model", "apiKeyEnv": "ANTHROPIC_API_KEY"
    }
  }

  // Also: "typingPauseMs" (default 2000), "socket" and "dataDir" (see the README).
}
